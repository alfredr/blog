# Serve the built site from the container image. The box server's proxy
# terminates TLS and forwards plain HTTP here.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	# The CSP keeps every page to this origin: no third-party scripts, fonts,
	# images or beacons. Inline scripts and styles stay allowed because the
	# templates and the self-contained gadgets use them.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# kiln's asset_url() adds a content hash (?v=...) to stylesheets, scripts
	# and the icon, so those URLs never change content: cache them for a year.
	# Revalidate everything else, including pages.
	@hashed query v=*
	@unhashed not query v=*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"
}
